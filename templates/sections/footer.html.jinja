<footer>
    <div class="container">
        <p>Generated on {{ generation_time.strftime('%Y-%m-%d %H:%M') }} • Dataset: {{ config.neuprint.dataset }} • Server: {{ config.neuprint.server }} • Generated via neuView {{ git_version }}{% if config.html.lab_url %} • <a href="{{ config.html.lab_url }}">{{ config.html.lab_name or config.html.lab_url }}</a>{% endif %}</p>
    </div>
    {# Feedback opens a GitHub issue, so it is gated by the github nav feature. #}
    {% if config.html.github_repo and (features is not defined or features.nav_visible('github')) %}
    <a href="#" id="feedback-btn" class="feedback-floating-btn" title="Report an issue or provide feedback by creating a GitHub issue (account required).">
        <img src="{{ '../' if is_neuron_page else '' }}static/icons/feedback.svg" alt="Feedback" class="feedback-icon">
    </a>
    {% endif %}
</footer>
